@using System.Globalization
@using Quilt4Net.Toolkit.Blazor.Framework
@using Quilt4Net.Toolkit.Features.Issue
@using Quilt4Net.Toolkit.Framework
@inject IIssueService IssueService

<ConnectionWrapper Service="Service.Issue" Ready="Ready">
    @if (_loadFailure != null)
    {
        <RadzenText>The roadmap could not be loaded. @_loadFailure</RadzenText>
    }
    else if (_figure == null)
    {
        <Loading Size="ProgressBarCircularSize.Small"/>
    }
    else if (_figure.Items.Length == 0 && _figure.FilteredItemCount > 0)
    {
        @ViewControls()
        <RadzenText TextStyle="TextStyle.Body1">Nothing matches the filter.</RadzenText>
        <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-secondary-color);">
            @_figure.FilteredItemCount item(s) are hidden by it.
        </RadzenText>
    }
    else if (_figure.Items.Length == 0)
    {
        <RadzenText TextStyle="TextStyle.Body1">Nothing to map yet.</RadzenText>
        <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-secondary-color);">
            A roadmap is drawn from issues that name a <b>route</b>. @UnroutedNote()
        </RadzenText>
    }
    else
    {
        @ViewControls()

        @* The hover highlight is CSS, not a Blazor event: pointing at a card must not cost a server
           round trip per mouse move, and it has to work on a read-only map too. Every card and edge
           carries q-n{number} for itself and for each card it touches, so one rule per card lights
           the card, its neighbours and its edges, and a general rule dims everything else. *@
        <style>@((MarkupString)_hoverCss)</style>

        @* The figure is wrapped so the click targets can sit over it as HTML. They cannot be SVG:
           Blazor does not attach event handlers to SVG-namespaced elements, so an @@onclick on a
           <rect> renders the shape and silently wires nothing - verified in the browser, where 83
           elements on the page carried a handler attribute and the rect carried none. Overlaying
           real buttons also makes the cards keyboard-reachable, which a drawing never was. *@
        @* Zoom scales the figure alone, not the page: the inner box keeps the layout's own
           coordinates, which is what the hit targets are placed in, and the sizer around it takes up
           the scaled size so the scrollbars match what is drawn. *@
        <div style="overflow: auto; max-width: 100%;">
         <div data-zoom="@N(_zoom)" style="width: @N(_figure.Width * _zoom)px; height: @N(_figure.Height * _zoom)px;">
          <div class="@_id" data-view="@_view.ToString().ToLowerInvariant()" style="position: relative; width: @N(_figure.Width)px; height: @N(_figure.Height)px; transform: scale(@N(_zoom)); transform-origin: 0 0;">
            <svg width="@N(_figure.Width)" height="@N(_figure.Height)"
                 viewBox="0 0 @N(_figure.Width) @N(_figure.Height)"
                 role="img" aria-label="Issue roadmap"
                 style="min-width: @N(_figure.Width)px; font-family: inherit;">
                <defs>
                    <clipPath id="@(_id)-avatar" clipPathUnits="objectBoundingBox">
                        <circle cx="0.5" cy="0.5" r="0.5"/>
                    </clipPath>
                    @* One arrowhead per colour: a marker cannot take its colour from the line it
                       ends, short of context-stroke, which older browsers draw black. *@
                    @foreach (var colour in MarkerColours())
                    {
                        <marker id="@MarkerId(colour)" viewBox="0 0 10 10" refX="9" refY="5"
                                markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                            <path d="M 0 0 L 10 5 L 0 10 z" fill="@colour"/>
                        </marker>
                    }
                </defs>

                @for (var i = 0; i < _figure.Lanes.Length; i++)
                {
                    var lane = _figure.Lanes[i];
                    @* Wrapped in <g> because Razor claims a bare <text> as its own control keyword
                       when it is the direct child of a code block, and SVG text is not that. *@
                    <g>
                        <rect x="0" y="@N(lane.Top)" width="@N(_figure.Width)" height="@N(lane.Height)"
                              fill="currentColor" opacity="@(i % 2 == 0 ? "0.03" : "0.06")"/>
                        <rect x="0" y="@N(lane.Top)" width="4" height="@N(lane.Height)" fill="@lane.Colour"/>
                        <text x="12" y="@N(lane.Top + 22)" fill="var(--rz-text-color)"
                              font-size="13" font-weight="600">@Truncate(lane.Name, 26)</text>
                    </g>
                }

                @for (var column = 0; column < _figure.Columns.Length; column++)
                {
                    var x = RoadmapLayout.GutterWidth + column * RoadmapLayout.BandWidth;
                    <g>
                        <line x1="@N(x)" y1="0" x2="@N(x)" y2="@N(_figure.Height)"
                              stroke="currentColor" stroke-opacity="0.15" stroke-width="1"/>
                        <text data-column x="@N(x + 12)" y="22" fill="var(--rz-text-secondary-color)"
                              font-size="12" letter-spacing="0.08em">@_figure.Columns[column].ToUpperInvariant()</text>
                    </g>
                }

                @if (_figure.UnlinkedTop.HasValue)
                {
                    <g>
                        <text data-unlinked x="@N(RoadmapNetworkLayout.Padding)" y="@N(_figure.UnlinkedTop.Value + 22)"
                              fill="var(--rz-text-secondary-color)" font-size="12" letter-spacing="0.08em">NO LINKS</text>
                    </g>
                }

                @foreach (var edge in _figure.Edges)
                {
                    <path class="q-edge q-n@(edge.From.Item.Number) q-n@(edge.To.Item.Number)"
                          d="@edge.Path()" fill="none"
                          stroke="@edge.From.Colour" stroke-opacity="0.75" stroke-width="2"
                          stroke-dasharray="@DashFor(edge.Edge.Kind)"
                          marker-end="@(edge.Edge.Kind == IssueLinkKind.Overlaps ? null : $"url(#{MarkerId(edge.From.Colour)})")">
                        <title>@edge.From.Item.Number → @edge.To.Item.Number (@edge.Edge.Kind.ToString().ToLowerInvariant()): @edge.Edge.Reason</title>
                    </path>
                }

                @foreach (var placed in _figure.Items)
                {
                    var item = placed.Item;
                    <g class="@CardClass(item.Number)" data-hover="@item.Number">
                      <g opacity="@(item.IsTerminal ? "0.45" : "1")">
                        <title>@TitleFor(placed)</title>
                        <rect data-card x="@N(placed.X)" y="@N(placed.Y)"
                              width="@N(placed.Width)" height="@N(placed.Height)"
                              rx="6" fill="var(--rz-base)" stroke="@placed.Colour"
                              stroke-width="1.5"/>

                        @* Status as a bar down the leading edge rather than a word: it reads at a
                           glance across a whole lane, which a right-aligned label never did. The
                           state name stays on the card beside it, because a colour nobody has a
                           legend for is decoration. *@
                        <rect x="@N(placed.X)" y="@N(placed.Y + 8)" width="3" height="@N(placed.Height - 16)"
                              rx="1.5" fill="@StatusColour(item)"/>

                        @if (item.IsQuickWin)
                        {
                            <circle cx="@N(placed.Right - 14)" cy="@N(placed.Y + 14)"
                                    r="5" fill="none" stroke="var(--rz-text-color)" stroke-width="2"/>
                        }
                        @* The issue's place in the team's one order, before its number, as on the board. *@
                        @if (item.Position is { } position)
                        {
                            <g data-position>
                                <rect x="@N(placed.X + 10)" y="@N(placed.Y + 8)" width="@N(PositionWidth(position))" height="16"
                                      rx="8" fill="rgba(128,128,128,0.18)"/>
                                <text x="@N(placed.X + 10 + PositionWidth(position) / 2)" y="@N(placed.Y + 20)" font-size="11"
                                      text-anchor="middle" fill="var(--rz-text-color)">@position</text>
                            </g>
                        }
                        <text x="@N(placed.X + 12 + (item.Position is { } p ? PositionWidth(p) + 4 : 0))" y="@N(placed.Y + 20)" font-size="12" font-weight="700"
                              fill="var(--rz-text-secondary-color)">#@item.Number</text>
                        <text x="@N(placed.X + 12)" y="@N(placed.Y + 38)" font-size="13"
                              fill="var(--rz-text-color)">@Truncate(item.Title, TitleLength(placed))</text>

                        @* The network card has no third row: state is in the tooltip, and the status
                           bar still carries it at a glance. *@
                        @if (_view == RoadmapView.Lanes)
                        {
                            <g>
                                <circle cx="@N(placed.X + 16)" cy="@N(placed.Y + 57)" r="4" fill="@StatusColour(item)"/>
                                <text data-state x="@N(placed.X + 26)" y="@N(placed.Y + 61)" font-size="11"
                                      fill="var(--rz-text-secondary-color)">@Truncate(StateLabel(item), 20)</text>
                            </g>
                        }

                        @* Who, as a picture: the assignee's avatar, or a machine when only a session
                           has claimed it. The words - name, claimant, machine, last seen - are the
                           mark's own tooltip, since a name in a corner was cut to 18 characters and a
                           machine name is what got cut. *@
                        @if (PersonMark(placed) is { } mark)
                        {
                            @if (!string.IsNullOrEmpty(AssigneeFor(item)))
                            {
                                <g data-assignee data-tip="@PersonTip(item)">
                                    <title>@PersonTip(item)</title>
                                    <circle cx="@N(mark.Cx)" cy="@N(mark.Cy)" r="@N(AvatarRadius)"
                                            fill="@placed.Colour" opacity="0.85"/>
                                    <text data-initials x="@N(mark.Cx)" y="@N(mark.Cy + 3.5)" font-size="9.5" font-weight="700"
                                          text-anchor="middle" fill="#ffffff">@Initials(AssigneeFor(item))</text>
                                    @* Over the initials rather than instead of them: an image that fails
                                       to load draws nothing in SVG, and the initials then show through. *@
                                    @if (!string.IsNullOrEmpty(item.AssignedUserIconUrl))
                                    {
                                        <image data-avatar href="@item.AssignedUserIconUrl"
                                               x="@N(mark.Cx - AvatarRadius)" y="@N(mark.Cy - AvatarRadius)"
                                               width="@N(AvatarRadius * 2)" height="@N(AvatarRadius * 2)"
                                               preserveAspectRatio="xMidYMid slice" clip-path="url(#@(_id)-avatar)"/>
                                    }
                                    @* A live claim is still worth seeing without pointing at it: a dot
                                       on the avatar, hollow once the claim has gone stale. *@
                                    @if (item.Claim != null)
                                    {
                                        <circle data-claim data-stale="@(item.Claim.IsStale ? "true" : "false")"
                                                cx="@N(mark.Cx + AvatarRadius * 0.75)" cy="@N(mark.Cy + AvatarRadius * 0.75)" r="3.5"
                                                fill="@(item.Claim.IsStale ? "var(--rz-base)" : "var(--rz-success)")"
                                                stroke="@(item.Claim.IsStale ? "var(--rz-text-tertiary-color)" : "var(--rz-base)")"
                                                stroke-width="1.5"/>
                                    }
                                </g>
                            }
                            else
                            {
                                @* A stale claim is faded, so "somebody is on it" and "somebody was" do
                                   not look alike. *@
                                <g data-claim data-stale="@(item.Claim.IsStale ? "true" : "false")" data-tip="@PersonTip(item)"
                                   opacity="@(item.Claim.IsStale ? "0.45" : "1")">
                                    <title>@PersonTip(item)</title>
                                    <circle cx="@N(mark.Cx)" cy="@N(mark.Cy)" r="@N(AvatarRadius)" fill="var(--rz-base-200)"/>
                                    <rect x="@N(mark.Cx - 5)" y="@N(mark.Cy - 5)" width="10" height="7" rx="1"
                                          fill="none" stroke="@(item.Claim.IsStale ? "var(--rz-text-tertiary-color)" : "var(--rz-primary)")" stroke-width="1.4"/>
                                    <path d="M @N(mark.Cx - 3) @N(mark.Cy + 5) H @N(mark.Cx + 3) M @N(mark.Cx) @N(mark.Cy + 2) V @N(mark.Cy + 5)"
                                          stroke="@(item.Claim.IsStale ? "var(--rz-text-tertiary-color)" : "var(--rz-primary)")" stroke-width="1.4"/>
                                </g>
                            }
                        }

                        @* Waiting (#131): a pennant left of the effort, amber, red once its date has
                           passed. The reason is the tooltip; the card has no room for a sentence. *@
                        @if (item.Waiting is { } waiting)
                        {
                            var fx = placed.Right - (item.IsQuickWin ? 26 : 12) - (item.Effort.HasValue ? 26 : 0) - 10;
                            var colour = waiting.IsDue ? "var(--rz-danger)" : "var(--rz-warning)";
                            <g data-waiting data-due="@(waiting.IsDue ? "true" : "false")" data-tip="@WaitingTip(waiting)">
                                <title>@WaitingTip(waiting)</title>
                                <path d="M @N(fx) @N(placed.Y + 9) V @N(placed.Y + 22)" stroke="@colour" stroke-width="1.6"/>
                                <path d="M @N(fx) @N(placed.Y + 9) H @N(fx + 9) L @N(fx + 6.5) @N(placed.Y + 12.5) L @N(fx + 9) @N(placed.Y + 16) H @N(fx) Z" fill="@colour"/>
                            </g>
                        }

                        @if (item.Effort.HasValue)
                        {
                            <g>
                                <text x="@N(placed.Right - (item.IsQuickWin ? 26 : 12))" y="@N(placed.Y + 20)"
                                      font-size="12" text-anchor="end"
                                      fill="var(--rz-text-secondary-color)">· @item.Effort.Value</text>
                            </g>
                        }
                      </g>
                    </g>
                }

                @* The pointed-at card's edges again, above the cards. The edges proper are drawn
                   under the cards so a card is never crossed out, which also means a lit edge
                   would run beneath every card in its way; this layer is invisible until its card
                   is pointed at, and never takes the pointer. *@
                <g data-highlight-layer>
                    @foreach (var edge in _figure.Edges)
                    {
                        <path class="q-hi q-n@(edge.From.Item.Number) q-n@(edge.To.Item.Number)"
                              d="@edge.Path()" fill="none"
                              stroke="@edge.From.Colour" stroke-width="3"
                              stroke-dasharray="@DashFor(edge.Edge.Kind)"
                              marker-end="@(edge.Edge.Kind == IssueLinkKind.Overlaps ? null : $"url(#{MarkerId(edge.From.Colour)})")"/>
                    }
                </g>
            </svg>

            @if (Selectable)
            {
                @foreach (var placed in _figure.Items)
                {
                    var number = placed.Item.Number;
                    <button type="button"
                            data-issue="@number"
                            data-hover="@number"
                            class="@(_neighbours.TryGetValue(number, out var n) && n.Count > 0 ? "q-linked" : null)"
                            title="@TitleFor(placed)"
                            aria-label="@($"Issue #{number}: {placed.Item.Title}")"
                            @onclick="@(() => OnItemClickAsync(number))"
                            style="position: absolute; left: @N(placed.X)px; top: @N(placed.Y)px; width: @N(placed.Width)px; height: @N(placed.Height)px; padding: 0; margin: 0; border: 0; border-radius: 6px; background: transparent; cursor: pointer;"></button>

                    @* The button covers the card, so its title would hide the avatar's own. A
                       small target over the mark carries that tooltip, and clicks through to the
                       same issue. *@
                    @if (PersonMark(placed) is { } mark)
                    {
                        <span data-person="@number"
                              data-hover="@number"
                              class="@(_neighbours.TryGetValue(number, out var m) && m.Count > 0 ? "q-linked" : null)"
                              title="@PersonTip(placed.Item)"
                              @onclick="@(() => OnItemClickAsync(number))"
                              style="position: absolute; left: @N(mark.Cx - AvatarRadius)px; top: @N(mark.Cy - AvatarRadius)px; width: @N(AvatarRadius * 2)px; height: @N(AvatarRadius * 2)px; border-radius: 50%; cursor: pointer;"></span>
                    }
                }
            }
          </div>
         </div>
        </div>

        <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-secondary-color); margin-top: 0.5rem;">
            @_figure.Items.Length item(s) across @_figure.Routes.Length route(s), @_figure.Edges.Length edge(s).
            Snapshot @_generatedUtc.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) UTC. @UnroutedNote() @FilteredNote()
        </RadzenText>
    }
</ConnectionWrapper>

@code {
    /// <summary>The position pill's width: room for its digits.</summary>
    private static double PositionWidth(int position) => 10 + 7 * position.ToString(System.Globalization.CultureInfo.InvariantCulture).Length;

    private readonly string _id = $"q4n-roadmap-{Guid.NewGuid():N}";
    private RoadmapFigure _figure;
    private RoadmapResponse _roadmap;
    private DateTime _generatedUtc;
    private int _unroutedCount;
    private int _hiddenCount;
    private string _loadFailure;

    /// <summary>
    /// No longer renders anything. The "how to read it" cells and the legends were removed; the
    /// route and link-kind choices that replaced the legends are part of the view controls (see
    /// <see cref="ShowViewControls"/>). Kept so a host that sets it still renders.
    /// </summary>
    [Parameter]
    [Obsolete("The legends and the how-to-read cells were removed. The route and link-kind choices are part of the view controls.")]
    public bool ShowHowToRead { get; set; } = true;

    /// <summary>
    /// Set by a host that resolves <see cref="IIssueService"/> in-process rather than over HTTP, so
    /// there is no remote endpoint to probe. The connectivity check answers "can this host reach
    /// Quilt4Net", which is not a question an in-process implementation has.
    /// </summary>
    /// <remarks>
    /// Leave this alone in a remote project: the probe is what turns an unreachable server or a
    /// missing API key into "Not connected to Quilt4Net" instead of a bare failure.
    /// </remarks>
    [Parameter]
    public bool Ready { get; set; }

    /// <summary>
    /// Raised with an issue number when its card is clicked. Leave unset in a host that has nothing
    /// to open — the cards then render as a figure rather than as controls, because a pointer cursor
    /// over something that does nothing is a worse answer than a plain box.
    /// </summary>
    /// <remarks>
    /// An <c>EventCallback</c> rather than the component opening an editor itself: this component is
    /// embedded by remote projects that have no issue dialog, and many of them hold a read-only key.
    /// The host decides what a click means.
    /// </remarks>
    [Parameter]
    public EventCallback<int> OnItemSelected { get; set; }

    /// <summary>
    /// Names for assignee keys, supplied by a host that knows its roster. Optional — the server
    /// already resolves <see cref="RoadmapItemResponse.AssignedUserName"/>, and this only overrides
    /// it.
    /// </summary>
    [Parameter]
    public IReadOnlyDictionary<string, string> MemberNames { get; set; }

    /// <summary>
    /// Which issues to draw. Leave unset to draw everything. Applied here rather than on the server,
    /// so the projection stays one whole picture and changing the filter needs no round trip.
    /// </summary>
    /// <remarks>
    /// A band the filter excludes is dropped from the map, not drawn empty. Terminal items are drawn
    /// in a Closed column left of Now, which exists only while it holds something — so a filter
    /// without the terminal states shows no Closed column at all.
    /// </remarks>
    [Parameter]
    public IssueFilter Filter { get; set; }

    /// <summary>
    /// Which arrangement to draw. Bind it (<c>@@bind-View</c>) to remember the reader's choice; left
    /// unbound, the component keeps it for as long as it lives.
    /// </summary>
    [Parameter]
    public RoadmapView View { get; set; }

    [Parameter]
    public EventCallback<RoadmapView> ViewChanged { get; set; }

    /// <summary>Drops cards with no link left on the map. Bindable, like <see cref="View"/>.</summary>
    [Parameter]
    public bool HideUnlinked { get; set; }

    [Parameter]
    public EventCallback<bool> HideUnlinkedChanged { get; set; }

    /// <summary>Whether to draw the view switch and the hide-unlinked toggle above the figure.</summary>
    [Parameter]
    public bool ShowViewControls { get; set; } = true;

    private bool Selectable => OnItemSelected.HasDelegate;

    private RoadmapView _view;
    private bool _hideUnlinked;

    /// <summary>
    /// Fixed steps rather than a free factor, so the label always reads as a round number and two
    /// clicks out and two in land back exactly where they started.
    /// </summary>
    private static readonly double[] ZoomSteps = [0.25, 0.33, 0.5, 0.67, 0.75, 0.9, 1, 1.1, 1.25, 1.5, 2];

    private double _zoom = 1;

    private void Zoom(int direction)
    {
        var at = Array.IndexOf(ZoomSteps, _zoom);
        if (at < 0) at = Array.IndexOf(ZoomSteps, 1d);
        _zoom = ZoomSteps[Math.Clamp(at + direction, 0, ZoomSteps.Length - 1)];
    }
    private string _hoverCss = string.Empty;
    private Dictionary<int, HashSet<int>> _neighbours = new();

    // What the current figure was laid out from. The network layout is a few hundred passes over
    // every pair of cards, and a parent re-render calls OnParametersSet with nothing changed.
    private (RoadmapResponse Roadmap, IssueFilter Filter, RoadmapView View, bool HideUnlinked, string[] Routes, IssueLinkKind[] Kinds) _laidOut;

    // The reader's route and link-kind choices. Empty means everything. A new array on every change,
    // so the layout key above sees the change by reference.
    private string[] _routeChoice = [];
    private IssueLinkKind[] _kindChoice = [];

    // The last values the host passed. Adopted only when they change, so an unbound component keeps
    // the reader's choice through a parent re-render instead of snapping back to the default.
    private RoadmapView? _viewParameter;
    private bool? _hideUnlinkedParameter;

    protected override void OnParametersSet()
    {
        if (_viewParameter != View) _view = View;
        if (_hideUnlinkedParameter != HideUnlinked) _hideUnlinked = HideUnlinked;
        _viewParameter = View;
        _hideUnlinkedParameter = HideUnlinked;
        Relayout();
        base.OnParametersSet();
    }

    private void Relayout()
    {
        if (_roadmap == null) return;

        var key = (_roadmap, Filter, _view, _hideUnlinked, _routeChoice, _kindChoice);
        if (_figure != null && _laidOut == key) return;

        _figure = RoadmapLayout.Build(_roadmap, Filter, _view, _hideUnlinked, _routeChoice, _kindChoice);
        _laidOut = key;

        _neighbours = _figure.Items.ToDictionary(x => x.Item.Number, _ => new HashSet<int>());
        foreach (var edge in _figure.Edges)
        {
            _neighbours[edge.From.Item.Number].Add(edge.To.Item.Number);
            _neighbours[edge.To.Item.Number].Add(edge.From.Item.Number);
        }

        _hoverCss = HoverCss();
    }

    /// <summary>
    /// The general rule dims every card and edge while any card is pointed at; the per-card rule,
    /// later and of equal specificity, restores the ones that carry the pointed-at card's class. Only
    /// cards with a link get a rule, so pointing at a loner does not blank the whole map.
    /// </summary>
    private string HoverCss()
    {
        var scope = $".{_id}";
        var css = new System.Text.StringBuilder();
        css.Append($"{scope} .q-hi {{ opacity: 0; pointer-events: none; }}\n");
        css.Append($"{scope}:has([data-hover].q-linked:hover) .q-edge {{ opacity: 0.1; }}\n");
        css.Append($"{scope}:has([data-hover].q-linked:hover) .q-card {{ opacity: 0.3; }}\n");
        foreach (var number in _neighbours.Where(x => x.Value.Count > 0).Select(x => x.Key))
        {
            css.Append($"{scope}:has([data-hover=\"{number}\"]:hover) :is(.q-card.q-n{number}, .q-hi.q-n{number}) {{ opacity: 1; }}\n");
        }

        return css.ToString();
    }

    private string CardClass(int number)
    {
        var classes = new List<string> { "q-card", $"q-n{number}" };
        if (_neighbours.TryGetValue(number, out var neighbours) && neighbours.Count > 0)
        {
            classes.Add("q-linked");
            classes.AddRange(neighbours.Order().Select(x => $"q-n{x}"));
        }

        return string.Join(" ", classes);
    }

    private IEnumerable<string> MarkerColours() =>
        _figure.Edges.Select(x => x.From.Colour).Distinct(StringComparer.Ordinal);

    private string MarkerId(string colour) => $"{_id}-arrow-{colour.TrimStart('#')}";

    private async Task SetViewAsync(RoadmapView view)
    {
        _view = view;
        Relayout();
        await ViewChanged.InvokeAsync(view);
    }

    private async Task SetHideUnlinkedAsync(bool value)
    {
        _hideUnlinked = value;
        Relayout();
        await HideUnlinkedChanged.InvokeAsync(value);
    }

    private RenderFragment ViewControls() => __builder =>
    {
        if (!ShowViewControls) return;
        <div data-view-controls style="display: flex; flex-wrap: wrap; gap: 1.25rem; align-items: center; margin-bottom: 1rem;">
            <RadzenSelectBar TValue="RoadmapView" Value="@_view" ValueChanged="@SetViewAsync" Size="ButtonSize.Small">
                <Items>
                    <RadzenSelectBarItem Text="Lanes" Value="RoadmapView.Lanes"/>
                    <RadzenSelectBarItem Text="Network" Value="RoadmapView.Network"/>
                </Items>
            </RadzenSelectBar>
            <span data-zoom-controls style="display: inline-flex; align-items: center; gap: 0.25rem;">
                <RadzenButton Icon="zoom_out" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text"
                              Disabled="@(_zoom <= ZoomSteps[0])" Click="@(() => Zoom(-1))" title="Zoom out"/>
                <RadzenButton Text="@($"{Math.Round(_zoom * 100)}%")" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text"
                              Click="@(() => _zoom = 1)" title="Back to 100%" Style="min-width: 4rem;"/>
                <RadzenButton Icon="zoom_in" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text"
                              Disabled="@(_zoom >= ZoomSteps[^1])" Click="@(() => Zoom(1))" title="Zoom in"/>
            </span>
            <span style="display: inline-flex; align-items: center; gap: 0.5rem;">
                <RadzenSwitch Value="@_hideUnlinked" ValueChanged="@((bool v) => SetHideUnlinkedAsync(v))" Name="@($"{_id}-hide-unlinked")"/>
                <RadzenLabel Text="Hide cards with no links" Component="@($"{_id}-hide-unlinked")"/>
            </span>
        </div>

        @* The routes, as a choice rather than a legend: picking some collapses the map to them, and
           picking none shows every route. Each item still carries its colour, so the bar is also
           the key to the colours, which in the network view are the only sign of a card's route. *@
        @if (_figure?.Routes.Length > 0)
        {
            <div data-route-legend style="margin-bottom: 0.75rem;">
                <RadzenSelectBar TValue="IEnumerable<string>" Multiple="true" Size="ButtonSize.Small"
                                 Value="@_routeChoice" ValueChanged="@((IEnumerable<string> v) => SetRoutes(v))">
                    <Items>
                        @foreach (var route in _figure.Routes)
                        {
                            <RadzenSelectBarItem Value="@route.Name" Text="@route.Name">
                                <Template>
                                    <span style="display: inline-flex; align-items: center; gap: 0.4rem;">
                                        <svg width="12" height="12" role="presentation">
                                            <rect x="1" y="1" width="10" height="10" rx="2" fill="@route.Colour"/>
                                        </svg>
                                        @route.Name
                                    </span>
                                </Template>
                            </RadzenSelectBarItem>
                        }
                    </Items>
                </RadzenSelectBar>
            </div>
        }

        @* The kinds of link, chosen the same way: none picked draws every kind. The line sample is
           the key to the dashes. *@
        <div data-kind-legend style="margin-bottom: 1rem;">
            <RadzenSelectBar TValue="IEnumerable<IssueLinkKind>" Multiple="true" Size="ButtonSize.Small"
                             Value="@_kindChoice" ValueChanged="@((IEnumerable<IssueLinkKind> v) => SetKinds(v))">
                <Items>
                    @foreach (var kind in new[] { IssueLinkKind.Blocks, IssueLinkKind.Cheapens, IssueLinkKind.Overlaps })
                    {
                        <RadzenSelectBarItem Value="@kind" Text="@kind.ToString()">
                            <Template>
                                <span style="display: inline-flex; align-items: center; gap: 0.4rem;" title="@LegendFor(kind)">
                                    <svg width="34" height="10" role="presentation">
                                        <line x1="1" y1="5" x2="33" y2="5" stroke="currentColor" stroke-width="2"
                                              stroke-dasharray="@DashFor(kind)"/>
                                    </svg>
                                    @kind
                                </span>
                            </Template>
                        </RadzenSelectBarItem>
                    }
                </Items>
            </RadzenSelectBar>
        </div>
    };

    private void SetRoutes(IEnumerable<string> routes)
    {
        _routeChoice = (routes ?? []).ToArray();
        Relayout();
    }

    private void SetKinds(IEnumerable<IssueLinkKind> kinds)
    {
        _kindChoice = (kinds ?? []).ToArray();
        Relayout();
    }

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        await base.OnInitializedAsync();
    }

    /// <summary>
    /// Re-reads the projection and re-lays out the figure. Public so a host that edits an issue can
    /// show the result without a full page navigation.
    /// </summary>
    public async Task ReloadAsync()
    {
        try
        {
            _loadFailure = null;
            var roadmap = await IssueService.GetRoadmapAsync();
            _generatedUtc = roadmap.GeneratedUtc;
            _unroutedCount = roadmap.UnroutedCount;
            _hiddenCount = roadmap.HiddenCount;
            _roadmap = roadmap;
            Relayout();
        }
        catch (IssueServiceException e)
        {
            _loadFailure = e.Message;
        }

        StateHasChanged();
    }

    private Task OnItemClickAsync(int number) =>
        Selectable ? OnItemSelected.InvokeAsync(number) : Task.CompletedTask;

    /// <summary>
    /// Says what the figure is not showing, and why, in the reader's terms. A map that omits work
    /// silently is worse than one that admits it.
    /// </summary>
    private string UnroutedNote()
    {
        var parts = new List<string>();
        if (_unroutedCount > 0) parts.Add($"{_unroutedCount} issue(s) carry no route");
        if (_hiddenCount > 0) parts.Add($"{_hiddenCount} are routed but outside the drawn lanes");
        return parts.Count == 0 ? string.Empty : $"Not shown: {string.Join("; ", parts)}.";
    }

    /// <summary>What the filter is keeping off the map, so a filtered map is never mistaken for the whole one.</summary>
    private string FilteredNote()
    {
        var parts = new List<string>();
        if (_figure.FilteredItemCount > 0) parts.Add($"{_figure.FilteredItemCount} item(s)");
        if (_figure.FilteredEdgeCount > 0) parts.Add($"{_figure.FilteredEdgeCount} edge(s)");
        return parts.Count == 0 ? string.Empty : $"Hidden by the filter: {string.Join(", ", parts)}.";
    }

    private static string N(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);

    private static string DashFor(IssueLinkKind kind) => kind switch
    {
        IssueLinkKind.Blocks => "none",
        IssueLinkKind.Cheapens => "7 5",
        _ => "2 5"
    };

    private static string LegendFor(IssueLinkKind kind) => kind switch
    {
        IssueLinkKind.Blocks => "Blocks — cannot start until the source ships",
        IssueLinkKind.Cheapens => "Cheapens — cheaper or safer afterwards",
        _ => "Overlaps — same surface, give both to one owner"
    };

    /// <summary>
    /// Theme variables rather than literal colours, so the map stays legible in both light and dark
    /// and picks up a host's palette. <c>InProgress</c> is the only one given an accent — it is the
    /// state a reader scans for.
    /// </summary>
    private static string StatusColour(RoadmapStateKind kind) => kind switch
    {
        RoadmapStateKind.InProgress => "var(--rz-primary)",
        RoadmapStateKind.Done => "var(--rz-success)",
        _ => "var(--rz-text-disabled-color)"
    };

    /// <summary>
    /// As above, except that an ending which did not deliver is not drawn as a delivery. It needs no
    /// colour of its own: terminal items are already at 45% opacity, so grey-and-faded reads
    /// distinctly from the grey-at-full-opacity of the entry state.
    /// </summary>
    /// <remarks>
    /// Tested against <c>== false</c> rather than <c>!= true</c>. <c>null</c> means "no resolution to
    /// judge" — an open issue, or a server older than the field — and both must keep the behaviour
    /// they had before this existed. Inferring abandonment from absence would repaint every finished
    /// issue on every server that has not caught up yet.
    /// </remarks>
    private static string StatusColour(RoadmapItemResponse item) =>
        item.ResolutionIsSuccess == false
            ? "var(--rz-text-disabled-color)"
            : StatusColour(item.StateKind);

    /// <summary>
    /// The state name, plus the resolution when there is one: <c>Closed · Won't do</c> reads as a
    /// decision, where <c>Closed</c> alone leaves the reader to guess which kind of ending it was.
    /// </summary>
    private static string StateLabel(RoadmapItemResponse item) =>
        string.IsNullOrWhiteSpace(item.Resolution) ? item.State : $"{item.State} · {item.Resolution}";

    /// <summary>
    /// The host's roster wins over the server's, then the server's resolved name, then the raw key.
    /// The key is deliberately the last resort rather than blank: an issue assigned to somebody who
    /// has left the team should look wrong, not unassigned.
    /// </summary>
    private string AssigneeFor(RoadmapItemResponse item)
    {
        if (string.IsNullOrEmpty(item.AssignedUserKey)) return string.Empty;

        if (MemberNames != null && MemberNames.TryGetValue(item.AssignedUserKey, out var name) && !string.IsNullOrWhiteSpace(name))
            return name;

        return string.IsNullOrWhiteSpace(item.AssignedUserName) ? item.AssignedUserKey : item.AssignedUserName;
    }

    /// <summary>
    /// Deliberately an instance method: it has to resolve the assignee the same way the card does,
    /// or a host roster would leave the tooltip naming one person and the card another.
    /// </summary>
    private string TitleFor(PlacedItem placed)
    {
        var item = placed.Item;
        var parts = new List<string> { $"#{item.Number} {item.Title}", item.State };
        if (item.Position is { } position) parts.Add($"position {position} in the order");
        if (!string.IsNullOrEmpty(placed.Route)) parts.Add(placed.Route);
        if (item.Effort.HasValue) parts.Add(item.Effort.Value.ToString());

        var assignee = AssigneeFor(item);
        if (!string.IsNullOrEmpty(assignee)) parts.Add(assignee);

        if (item.Claim != null)
        {
            var stale = item.Claim.IsStale ? ", stale" : string.Empty;
            parts.Add($"claimed by {ClaimantFor(item.Claim)}, last seen {Ago(item.Claim.LastSeenUtc)}{stale}");
        }

        if (item.Waiting is { } waiting) parts.Add(WaitingTip(waiting));
        if (item.IsQuickWin) parts.Add("quick win");
        return string.Join(" · ", parts);
    }

    /// <summary>The waiting flag in words: the reason, what on, and the date, said to be due once passed.</summary>
    private static string WaitingTip(IssueWaitingResponse waiting)
    {
        var on = waiting.WaitsOn is { } kind ? $" on {kind.ToString().ToLowerInvariant()}" : string.Empty;
        var until = waiting.Until is { } date
            ? waiting.IsDue ? $", due since {date:yyyy-MM-dd}" : $", until {date:yyyy-MM-dd}"
            : string.Empty;
        return $"waiting{on}: {waiting.Reason}{until}";
    }

    private const double AvatarRadius = 9;

    /// <summary>
    /// Where the card's person mark goes, or <c>null</c> when there is nobody to draw: no assignee and
    /// no claim. Bottom right on a lane card; on the two-row network card, beside the title.
    /// </summary>
    private (double Cx, double Cy)? PersonMark(PlacedItem placed)
    {
        if (string.IsNullOrEmpty(AssigneeFor(placed.Item)) && placed.Item.Claim == null) return null;
        return _view == RoadmapView.Network
            ? (placed.Right - 18, placed.Y + 34)
            : (placed.Right - 20, placed.Y + 57);
    }

    /// <summary>The network title shares its row with the person mark, so it gives way to it.</summary>
    private int TitleLength(PlacedItem placed) =>
        _view != RoadmapView.Network ? 30 : PersonMark(placed) == null ? 24 : 22;

    /// <summary>
    /// The person mark's tooltip: who it is assigned to, then who has it open and from which machine.
    /// </summary>
    private string PersonTip(RoadmapItemResponse item)
    {
        var lines = new List<string>();
        var assignee = AssigneeFor(item);
        if (!string.IsNullOrEmpty(assignee)) lines.Add($"Assigned to {assignee}");

        if (item.Claim != null)
        {
            var who = string.IsNullOrWhiteSpace(item.Claim.User) ? "Claimed" : $"Claimed by {item.Claim.User}";
            var where = string.IsNullOrWhiteSpace(item.Claim.Machine) ? string.Empty : $" on {item.Claim.Machine}";
            var stale = item.Claim.IsStale ? ", stale" : string.Empty;
            lines.Add($"{who}{where}, last seen {Ago(item.Claim.LastSeenUtc)}{stale}");
        }

        return string.Join("\n", lines);
    }

    /// <summary>One letter for one word, first and last for more, as the team avatars do.</summary>
    private static string Initials(string name)
    {
        var words = name.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return words.Length switch
        {
            0 => "?",
            1 => char.ToUpperInvariant(words[0][0]).ToString(),
            _ => $"{char.ToUpperInvariant(words[0][0])}{char.ToUpperInvariant(words[^1][0])}"
        };
    }

    /// <summary>
    /// <c>user · machine</c>, dropping whichever part was not stated. The machine is the part that
    /// tells one person's two sessions apart, so it is never folded away when present.
    /// </summary>
    private static string ClaimantFor(IssueClaimResponse claim) =>
        string.Join(" · ", new[] { claim.User, claim.Machine }.Where(x => !string.IsNullOrWhiteSpace(x)));

    /// <summary>
    /// Measured against the snapshot's own time rather than the clock, so the figure and its caption
    /// agree about "now" however long the page has been open.
    /// </summary>
    private string Ago(DateTime utc)
    {
        var age = _generatedUtc - utc;
        if (age < TimeSpan.FromMinutes(1)) return "just now";
        if (age < TimeSpan.FromHours(1)) return $"{(int)age.TotalMinutes}m ago";
        if (age < TimeSpan.FromDays(1)) return $"{(int)age.TotalHours}h ago";
        return $"{(int)age.TotalDays}d ago";
    }

    private static string Truncate(string value, int max) =>
        string.IsNullOrEmpty(value) || value.Length <= max ? value : value[..(max - 1)] + "…";
}
